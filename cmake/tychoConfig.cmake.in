@PACKAGE_INIT@

if(TARGET tycho::tycho)
    # Already configured by an earlier find_package(tycho)/find_dependency
    # (tycho) in this same CMake run. Everything below, including the
    # set_property(APPEND ...) reattachment block, already ran once; running
    # it again would duplicate entries on tycho::tycho's
    # INTERFACE_LINK_LIBRARIES rather than being a no-op. Nothing left to do.
    return()
endif()

include(CMakeFindDependencyMacro)

# Make tycho's Find modules available for find_dependency calls below.
# Save and restore to avoid polluting the consumer's module path.
set(_tycho_cmake_module_path "${CMAKE_MODULE_PATH}")
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

find_dependency(Threads)

# Re-find the sparse solver that tycho was built with
set(TYCHO_SPARSE_SOLVER "@TYCHO_SPARSE_SOLVER@")
if(TYCHO_SPARSE_SOLVER STREQUAL "AccelerateSparse")
    find_dependency(AccelerateSparse)
elseif(TYCHO_SPARSE_SOLVER STREQUAL "MKL")
    find_dependency(MKL)
else()
    message(FATAL_ERROR
        "tycho: unknown sparse solver '${TYCHO_SPARSE_SOLVER}'. "
        "Expected 'AccelerateSparse' or 'MKL'.")
endif()

# OpenMP handling (macOS only -- consumers need the libomp runtime to link tycho).
# On Linux/Windows, MKL_LIBRARIES includes Intel's libiomp5 for OpenMP linkage.
# We use find_library instead of find_dependency(OpenMP) because AppleClang does
# not support CMake's standard OpenMP detection.
set(TYCHO_NEEDS_OPENMP "@TYCHO_NEEDS_OPENMP@")
if(TYCHO_NEEDS_OPENMP)
    set(_tycho_libomp_dir "@TYCHO_LIBOMP_DIR@")
    find_library(_tycho_omp_lib omp
        PATHS
            "${_tycho_libomp_dir}/lib"
            /opt/homebrew/opt/libomp/lib       # Apple Silicon Homebrew
            /usr/local/opt/libomp/lib          # Intel Mac Homebrew
    )
    if(NOT _tycho_omp_lib)
        message(FATAL_ERROR
            "tycho: libomp not found. Install via: brew install libomp\n"
            "  Searched: ${_tycho_libomp_dir}/lib, "
            "/opt/homebrew/opt/libomp/lib, /usr/local/opt/libomp/lib")
    endif()
endif()

# Installed include root, computed via configure_package_config_file's
# PATH_VARS mechanism rather than hardcoding "include": a consumer that
# installed tycho with -DCMAKE_INSTALL_INCLUDEDIR=<something else> would
# otherwise fail every EXISTS check below (and Eigen3::Eigen's reconstructed
# INTERFACE_INCLUDE_DIRECTORIES) against a path that was never actually used.
set(_tycho_include_dir "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

# Eigen3 handling
set(TYCHO_USE_SYSTEM_EIGEN "@TYCHO_USE_SYSTEM_EIGEN@")
if(TYCHO_USE_SYSTEM_EIGEN)
    find_dependency(Eigen3 3.4)
else()
    # Bundled Eigen headers were installed alongside tycho
    if(NOT TARGET Eigen3::Eigen)
        if(NOT EXISTS "${_tycho_include_dir}/Eigen/Core")
            message(FATAL_ERROR
                "tycho: bundled Eigen headers not found at "
                "${_tycho_include_dir}/Eigen/. "
                "The tycho installation may be incomplete.")
        endif()
        add_library(Eigen3::Eigen INTERFACE IMPORTED)
        set_target_properties(Eigen3::Eigen PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${_tycho_include_dir}"
        )
    endif()
endif()

set(_tycho_targets_file "${CMAKE_CURRENT_LIST_DIR}/tychoTargets.cmake")
if(NOT EXISTS "${_tycho_targets_file}")
    message(FATAL_ERROR
        "tycho: required file not found: ${_tycho_targets_file}\n"
        "The tycho installation may be incomplete.")
endif()
include("${_tycho_targets_file}")
unset(_tycho_targets_file)

if(NOT TARGET tycho::tycho)
    message(FATAL_ERROR
        "tycho: target tycho::tycho was not defined by tychoTargets.cmake. "
        "The installation may be corrupted.")
endif()

# Validate critical installed headers are present
if(NOT EXISTS "${_tycho_include_dir}/tycho/tycho.h")
    message(FATAL_ERROR
        "tycho: public headers not found at "
        "${_tycho_include_dir}/tycho/. "
        "The tycho installation may be incomplete.")
endif()
if(NOT EXISTS "${_tycho_include_dir}/fmt/format.h")
    message(FATAL_ERROR
        "tycho: fmt headers not found at "
        "${_tycho_include_dir}/fmt/. "
        "The tycho installation may be incomplete.")
endif()
if(NOT EXISTS "${_tycho_include_dir}/hven/model/nlp_solver.h")
    message(FATAL_ERROR
        "tycho: hven headers not found at "
        "${_tycho_include_dir}/hven/. "
        "The tycho installation may be incomplete.")
endif()

# hven -- installed alongside tycho. hven is add_subdirectory()'d into this
# project with no PROJECT_IS_TOP_LEVEL guard on its own install rules, so
# `cmake --install` on tycho's build tree installs hven's package config
# (hvenConfig.cmake, hvenTargets.cmake) into this same prefix, next to
# tycho's own.
#
# Pinned to tycho's own install prefix FIRST (PATHS ... NO_DEFAULT_PATH):
# an unrestricted find_dependency(hven) searches the caller's entire
# CMAKE_PREFIX_PATH, so if some OTHER hven package happens to sit earlier on
# it, this would silently re-export a DIFFERENT build than the one tycho
# shipped and validated against -- tycho must re-export the archive it
# actually shipped. Only if tycho's own prefix genuinely lacks a usable hven
# config (a corrupted/partial install) do we fall back to an unrestricted
# search, so a consumer who deliberately points CMAKE_PREFIX_PATH at a
# differently-located hven for some other reason is not dead-ended.
find_package(hven QUIET CONFIG
    PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cmake/hven"
    NO_DEFAULT_PATH)
if(NOT hven_FOUND)
    find_dependency(hven)
endif()

if(NOT TARGET hven::hven)
    message(FATAL_ERROR
        "tycho: hven::hven target not found after find_dependency(hven). "
        "The tycho installation may be incomplete.")
endif()

# Re-attach transitive link dependencies that were stripped from the export.
# The tycho target uses BUILD_INTERFACE guards on its link libraries (see
# src/CMakeLists.txt line 105) to avoid encoding host-specific absolute paths
# in tychoTargets.cmake. CRITICAL: every library in LINK_LIBS (root
# CMakeLists.txt) must be re-found and re-attached below. If a new dependency
# is added to LINK_LIBS, it must also be added here.

# hven (re-found via find_package(hven)/find_dependency(hven) above)
set_property(TARGET tycho::tycho APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES hven::hven)

# Threads
set_property(TARGET tycho::tycho APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES Threads::Threads)

# Eigen3 (BUILD_INTERFACE-guarded in the build tree so the target the solver
# library defines there does not have to be exported; re-established above).
set_property(TARGET tycho::tycho APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES Eigen3::Eigen)

# Sparse solver
if(TYCHO_SPARSE_SOLVER STREQUAL "MKL")
    # Validate MKL was fully found. FindMKL.cmake does not include
    # MKL_OMP_LIBRARY in FIND_PACKAGE_HANDLE_STANDARD_ARGS, so MKL_FOUND=TRUE
    # can occur while libiomp5 (MKL_OMP_LIBRARY) was not found, leaving a
    # NOTFOUND entry in MKL_LIBRARIES.
    if(NOT MKL_LIBRARIES)
        message(FATAL_ERROR
            "tycho: MKL_LIBRARIES is empty after find_dependency(MKL). "
            "Set MKLROOT to the MKL installation directory.")
    endif()
    foreach(_mkl_lib IN LISTS MKL_LIBRARIES)
        if("${_mkl_lib}" MATCHES "NOTFOUND")
            message(FATAL_ERROR
                "tycho: MKL library not found: ${_mkl_lib}. "
                "Your MKL installation may be incomplete.")
        endif()
    endforeach()
    unset(_mkl_lib)
    if(UNIX AND NOT APPLE)
        set_property(TARGET tycho::tycho APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES
                -Wl,--start-group ${MKL_LIBRARIES} -Wl,--end-group)
    else()
        set_property(TARGET tycho::tycho APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES ${MKL_LIBRARIES})
    endif()
    if(MKL_INCLUDE_DIRS)
        set_property(TARGET tycho::tycho APPEND PROPERTY
            INTERFACE_INCLUDE_DIRECTORIES ${MKL_INCLUDE_DIRS})
    endif()
elseif(TYCHO_SPARSE_SOLVER STREQUAL "AccelerateSparse")
    # AccelerateSparse: re-found above via find_dependency(). Re-attach
    # explicitly on tycho::tycho, for resilience against future link-visibility
    # changes.
    if(NOT TARGET AccelerateSparse::AccelerateSparse)
        message(FATAL_ERROR
            "tycho: AccelerateSparse::AccelerateSparse target not found after "
            "find_dependency(AccelerateSparse).")
    endif()
    set_property(TARGET tycho::tycho APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES AccelerateSparse::AccelerateSparse)
endif()

# OpenMP (macOS only — libomp runtime)
if(TYCHO_NEEDS_OPENMP AND _tycho_omp_lib)
    set_property(TARGET tycho::tycho APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES "${_tycho_omp_lib}")
endif()

# System libraries
if(UNIX)
    set_property(TARGET tycho::tycho APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES ${CMAKE_DL_LIBS} m)
endif()

# Restore caller's CMAKE_MODULE_PATH. Assumes no find_dependency() call above
# legitimately appends entries the caller needs to keep.
set(CMAKE_MODULE_PATH "${_tycho_cmake_module_path}")
unset(_tycho_cmake_module_path)
unset(_tycho_include_dir)

check_required_components(tycho)
